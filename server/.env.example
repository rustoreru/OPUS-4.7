# Kinopoisk.dev API token (required for /api/kp/* endpoints).
# Get one free: https://t.me/kinopoiskdev_bot → /api
KINOPOISK_DEV_TOKEN=

# Alloha aggregator token (required for /api/source/alloha/stream).
# Contact: https://alloha.tv
ALLOHA_TOKEN=

# Optional outbound HTTP proxy for parsers that require CIS geo-access
# (HDRezka / Filmix / Zetflix often block datacenter/overseas IPs).
# Example: HTTP_PROXY=http://user:pass@proxy.example:3128
HTTP_PROXY=
